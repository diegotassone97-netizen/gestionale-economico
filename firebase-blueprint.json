{
  "entities": {
    "RevenueEntry": {
      "title": "RevenueEntry",
      "description": "Voce di ricavo o fatturato aggregato/puntuale",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID univoco del documento"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data contabile YYYY-MM-DD"
        },
        "amount": {
          "type": "number",
          "description": "Importo economico in Euro"
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Descrizione o causale del ricavo"
        },
        "type": {
          "type": "string",
          "enum": ["aggregato", "puntuale"],
          "description": "Tipologia di rilevazione del fatturato"
        },
        "aggregationPeriod": {
          "type": "string",
          "enum": ["giornaliero", "settimanale", "mensile", "progetto", "canale", "periodico"],
          "description": "Periodicità di aggregazione per ricavi aggregati"
        },
        "stream": {
          "type": "string",
          "maxLength": 100,
          "description": "Canale o linea di business di provenienza"
        },
        "clientOrReference": {
          "type": "string",
          "maxLength": 150,
          "description": "Cliente pagatore o centro di ricavo"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["incassato", "in_attesa", "parziale"],
          "description": "Stato di incasso del corrispettivo"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Note o dettagli aggiuntivi"
        },
        "createdAt": {
          "type": "string",
          "description": "Data e ora di creazione ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data e ora di ultimo aggiornamento ISO string"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "description": "UID dell'utente o email del creatore"
        }
      },
      "required": ["date", "amount", "description", "type", "stream", "paymentStatus", "createdBy"]
    },
    "ExpenseEntry": {
      "title": "ExpenseEntry",
      "description": "Spesa operativa o costo fisso/variabile di gestione",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID univoco del documento"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data contabile della spesa YYYY-MM-DD"
        },
        "amount": {
          "type": "number",
          "description": "Importo speso in Euro"
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Descrizione della spesa o fornitura"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Categoria di costo aziendale"
        },
        "nature": {
          "type": "string",
          "enum": ["fissa", "variabile"],
          "description": "Natura del costo economico (fisso o variabile)"
        },
        "supplier": {
          "type": "string",
          "maxLength": 150,
          "description": "Fornitore o creditore"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["bonifico", "carta", "riba_rid", "contanti", "paypal", "f24_tasse_stimate", "altro"],
          "description": "Modalità di pagamento utilizzata o prevista"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pagata", "da_pagare", "programmata"],
          "description": "Stato del saldo della spesa"
        },
        "isRecurring": {
          "type": "boolean",
          "description": "Indica se la spesa è ricorrente periodica"
        },
        "recurringFrequency": {
          "type": "string",
          "enum": ["mensile", "trimestrale", "annuale"],
          "description": "Frequenza di addebito per spese ricorrenti"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Note descrittive o riferimenti fattura"
        },
        "createdAt": {
          "type": "string",
          "description": "Data e ora di creazione ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data e ora di ultimo aggiornamento ISO string"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "description": "UID dell'utente o email del creatore"
        }
      },
      "required": ["date", "amount", "description", "category", "nature", "paymentMethod", "paymentStatus", "createdBy"]
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Utente abilitato con ruolo gestionale",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificativo documento utente o UID"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Email dell'utente autorizzato"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Nome completo dell'utente"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "collaborator"],
          "description": "Ruolo di accesso: admin o collaborator"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Stato di abilitazione dell'account"
        },
        "addedAt": {
          "type": "string",
          "description": "Data di abilitazione ISO string"
        },
        "lastLogin": {
          "type": "string",
          "description": "Timestamp ultimo accesso"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Note amministrative"
        }
      },
      "required": ["email", "name", "role", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Ruolo amministrativo globale per Diego Tassone",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Email dell'amministratore"
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Ruolo fisso admin"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp creazione"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/gestionale_fatturato/{revenueId}": {
      "schema": "RevenueEntry",
      "description": "Archivio ricavi e fatturato gestionale"
    },
    "/gestionale_spese/{expenseId}": {
      "schema": "ExpenseEntry",
      "description": "Archivio spese e costi operativi"
    },
    "/gestionale_utenti_autorizzati/{userId}": {
      "schema": "AuthorizedUser",
      "description": "Lista di utenti autorizzati ad accedere al gestionale"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Indice degli amministratori per verifica privilegi"
    }
  }
}
